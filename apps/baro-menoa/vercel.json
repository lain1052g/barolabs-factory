{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/send-notification",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/reset-upload-count",
      "schedule": "0 0 1 * *"
    }
  ]
}
